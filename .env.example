# Copy to .env and fill in. Never commit .env.

# Fireworks (trainer 1): https://app.fireworks.ai/settings/users/api-keys
FIREWORKS_API_KEY=
# Your Fireworks account id (the <id> in accounts/<id>/...)
FIREWORKS_ACCOUNT_ID=

# OpenRouter (turns documents into training examples). Requests are always
# pinned to zero-data-retention providers because they carry customer content.
OPENROUTER_API_KEY=
# Optional: override the open model used to write training examples.
# GENERATOR_MODEL=z-ai/glm-5.3

# Tinker (trainer 2): https://tinker-console.thinkingmachines.ai -> API Keys
TINKER_API_KEY=

# Hugging Face write token, for pushing finished adapters to a private repo
HF_TOKEN=

# OpenAI (writes training examples from your documents)
OPENAI_API_KEY=
