# Required for live training runs. Without these, POST /jobs returns 501
# and the Next.js app's FallbackTrainingProvider transparently uses the
# existing simulated run instead — nothing breaks if you leave this unset.
#
# Copy this file to .env and fill both in. Never commit .env.

# From the Tinker Console (thinkingmachines.ai). The account also needs
# credit loaded before any run will start.
TINKER_API_KEY=

# A Hugging Face token with WRITE access (Settings -> Access Tokens -> New
# token -> Write, or a fine-grained token with repo.write on your account).
# Different from — and more privileged than — the optional read-only
# HUGGINGFACE_TOKEN in the main app's .env. The trained adapter is published
# to this account, private by default.
HUGGINGFACE_WRITE_TOKEN=
