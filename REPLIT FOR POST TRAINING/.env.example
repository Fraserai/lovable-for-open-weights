# Optional. Public Hugging Face model search works without this — it only
# raises rate limits / enables gated-metadata visibility for authenticated
# requests. Get a token at https://huggingface.co/settings/tokens (a
# "read"-scoped token is enough). Never commit a real value.
HUGGINGFACE_TOKEN=

# Optional. Where the Tinker bridge service is running (see
# services/tinker-bridge/README.md). Defaults to localhost:8000 if unset —
# only needed if you run the bridge on a different port/host. The bridge
# itself holds the real credentials (TINKER_API_KEY, HUGGINGFACE_WRITE_TOKEN)
# in its own .env, never here — this app never sees those secrets.
TINKER_BRIDGE_URL=
